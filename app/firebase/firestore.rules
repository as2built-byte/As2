rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // Helper Functions
    // ========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Check if user is an enterprise (role == 'enterprise')
    function isEnterprise() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'enterprise';
    }

    // Check if user is a gérant (enterprise without enterpriseOwnerId)
    function isGerant() {
      return isEnterprise() &&
        !('enterpriseOwnerId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    // Check if user is the enterprise owner of a project
    function isProjectOwner(projectId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.enterpriseId == request.auth.uid;
    }

    // Check if user is a member assigned to a project's enterprise
    // Members have enterpriseOwnerId = gérant's uid, and gérant's uid = project.enterpriseId
    function isMemberOfProjectEnterprise(projectId) {
      return isEnterprise() &&
        'enterpriseOwnerId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enterpriseOwnerId == 
          get(/databases/$(database)/documents/projects/$(projectId)).data.enterpriseId;
    }
    
    // ========================================
    // Users Collection
    // ========================================
    match /users/{userId} {
      // Any authenticated user can read user profiles (needed for expert/enterprise name display)
      allow read: if isAuthenticated();
      
      // Users can create their own profile during registration
      // Gérant can also create member profiles (enterpriseOwnerId == gérant's uid)
      allow create: if isOwner(userId) || 
        (isGerant() && request.resource.data.enterpriseOwnerId == request.auth.uid);
      
      // Users can update their own profile (except role and status)
      // Admins can update any user (including role and status)
      // Gérant can update their members' status
      allow update: if isOwner(userId) || isAdmin() ||
        (isGerant() && 
         exists(/databases/$(database)/documents/users/$(userId)) &&
         get(/databases/$(database)/documents/users/$(userId)).data.enterpriseOwnerId == request.auth.uid);
      
      // Only admins can delete users, or gérant can delete their members
      allow delete: if isAdmin() ||
        (isGerant() && 
         exists(/databases/$(database)/documents/users/$(userId)) &&
         get(/databases/$(database)/documents/users/$(userId)).data.enterpriseOwnerId == request.auth.uid);
    }
    // ========================================
    // Experts Collection
    // ========================================
    match /experts/{userId} {
      // Authenticated users can read experts (for expert pool)
      allow read: if isAuthenticated();
      
      // Experts can create/update their own profile, admins can also update (for certifications)
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete expert profiles
      allow delete: if isAdmin();
    }

    // ========================================
    // Enterprises Collection
    // ========================================
    match /enterprises/{userId} {
      // Any authenticated user can read enterprise profiles (needed for experts to see who assigned the mission)
      allow read: if isAuthenticated();
      
      // Enterprises can create/update their own profile, admins can also update (for certifications)
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete enterprise profiles
      allow delete: if isAdmin();
    }
    
    // ========================================
    // Formations Collection
    // ========================================
    match /formations/{formationId} {
      // Anyone authenticated can read formations
      allow read: if isAuthenticated();
      
      // Only admins can create, update, delete formations
      allow create, update, delete: if isAdmin();
    }
    
    // ========================================
    // Packs Collection
    // ========================================
    match /packs/{packId} {
      // Anyone authenticated can read packs
      allow read: if isAuthenticated();
      
      // Only admins can create, update, delete packs
      allow create, update, delete: if isAdmin();
    }
    
    // ========================================
    // Payments Collection
    // ========================================
    match /payments/{paymentId} {
      // Admins can read all payments
      allow read: if isAdmin();
      
      // Users can read their own payments
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Authenticated users can create their own payments
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Only admins can update or delete payments
      allow update, delete: if isAdmin();
    }
    
    // ========================================
    // Notifications Collection
    // ========================================
    match /notifications/{notificationId} {
      // Admins can read all notifications, users can read their own
      allow read: if isAdmin() || 
                     (isAuthenticated() && resource.data.targetUserId == request.auth.uid);
      
      // Authenticated users can create notifications
      allow create: if isAuthenticated();
      
      // Admins can update/delete all, users can update (mark as read) their own
      allow update: if isAdmin() || 
                       (isAuthenticated() && resource.data.targetUserId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    // ========================================
    // Projects Collection
    // ========================================
    match /projects/{projectId} {
      // Any authenticated user can read projects (needed for experts to see projects they have missions in)
      allow read: if isAuthenticated();
      
      // Authenticated enterprises can create their own projects
      allow create: if isAuthenticated() && 
        request.resource.data.enterpriseId == request.auth.uid;
      
      // Enterprise owner or admin can update projects
      allow update: if isAuthenticated() && (
        resource.data.enterpriseId == request.auth.uid || isAdmin()
      );
      
      // Only admins can delete projects
      allow delete: if isAdmin();
    }
    
    // ========================================
    // Documents Collection (Project Documents)
    // ========================================
    match /documents/{documentId} {
      // Read: creator (CRUD), or any authenticated user on the same project (R)
      // Since project read is open to all authenticated, documents follow the same pattern
      allow read: if isAuthenticated();
      
      // Create: any authenticated user (enterprise, expert, admin)
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid;
      
      // Update: only the creator (senderId) can update
      allow update: if isAuthenticated() && 
        resource.data.senderId == request.auth.uid;
      
      // Delete: creator can delete, enterprise owner, or assigned member
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || isProjectOwner(resource.data.projectId) || isMemberOfProjectEnterprise(resource.data.projectId)
      );
    }
    
    // ========================================
    // Photos Collection
    // ========================================
    match /photos/{photoId} {
      // Read: any authenticated user
      allow read: if isAuthenticated();
      
      // Create: any authenticated user (enterprise, expert, admin)
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid;
      
      // Update: only the creator (senderId) can update
      allow update: if isAuthenticated() && 
        resource.data.senderId == request.auth.uid;
      
      // Delete: creator can delete, enterprise owner, or assigned member
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || isProjectOwner(resource.data.projectId) || isMemberOfProjectEnterprise(resource.data.projectId)
      );
    }
    
    // ========================================
    // Problems Collection
    // ========================================
    match /problems/{problemId} {
      // Read: any authenticated user
      allow read: if isAuthenticated();
      
      // Create: any authenticated user (enterprise, expert, admin)
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid;
      
      // Update: only the creator (senderId) can update
      allow update: if isAuthenticated() && 
        resource.data.senderId == request.auth.uid;
      
      // Delete: creator can delete, enterprise owner, or assigned member
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || isProjectOwner(resource.data.projectId) || isMemberOfProjectEnterprise(resource.data.projectId)
      );
    }
    
    // ========================================
    // RFIs Collection
    // ========================================
    match /rfis/{rfiId} {
      // Read: any authenticated user
      allow read: if isAuthenticated();
      
      // Create: any authenticated user
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid;
      
      // Update: only the creator (senderId) can update
      allow update: if isAuthenticated() && 
        resource.data.senderId == request.auth.uid;
      
      // Delete: creator can delete, enterprise owner, or assigned member
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || isProjectOwner(resource.data.projectId) || isMemberOfProjectEnterprise(resource.data.projectId)
      );
    }
    
    // ========================================
    // Submissions Collection
    // ========================================
    match /submissions/{submissionId} {
      // Read: any authenticated user
      allow read: if isAuthenticated();
      
      // Create: any authenticated user, status must be 'pending'
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      // Update: creator can update title/description (not status),
      //         enterprise owner or assigned member can update status only
      allow update: if isAuthenticated() && (
        (resource.data.senderId == request.auth.uid && request.resource.data.status == resource.data.status) ||
        ((isProjectOwner(resource.data.projectId) || isMemberOfProjectEnterprise(resource.data.projectId)) && request.resource.data.title == resource.data.title && request.resource.data.description == resource.data.description)
      );
      
      // Delete: creator can delete, enterprise owner, or assigned member
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || isProjectOwner(resource.data.projectId) || isMemberOfProjectEnterprise(resource.data.projectId)
      );
    }
    
    // ========================================
    // Missions Collection
    // ========================================
    match /missions/{missionId} {
      // Any authenticated user can read missions (consistent with projects, documents, etc.)
      // Data filtering is handled in application code
      allow read: if isAuthenticated();
      
      // Enterprises or assigned members can create missions for their projects
      allow create: if isAuthenticated() && (
        request.resource.data.enterpriseId == request.auth.uid ||
        isMemberOfProjectEnterprise(request.resource.data.projectId)
      );
      
      // Admin can update any mission (for assigning expert)
      // Expert can update missions assigned to them (for accept/refuse)
      // Enterprise owner or assigned member can update their missions
      allow update: if isAuthenticated() && (
        resource.data.enterpriseId == request.auth.uid ||
        resource.data.expertId == request.auth.uid ||
        isAdmin() ||
        isMemberOfProjectEnterprise(resource.data.projectId)
      );
      
      // Enterprise owner, assigned member, or admin can delete missions
      allow delete: if isAuthenticated() && (
        resource.data.enterpriseId == request.auth.uid || 
        isAdmin() ||
        isMemberOfProjectEnterprise(resource.data.projectId)
      );
    }

    // ========================================
    // Project Members Collection
    // ========================================
    match /project_members/{docId} {
      // Gérant can read assignments for their members, members can read their own
      allow read: if isAuthenticated();
      
      // Only gérant can create assignments for their own members and projects
      allow create: if isGerant() && 
        request.resource.data.assignedBy == request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.memberId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.memberId)).data.enterpriseOwnerId == request.auth.uid &&
        exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) &&
        get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.enterpriseId == request.auth.uid;
      
      // Only gérant can delete assignments for their own members
      allow delete: if isGerant() &&
        exists(/databases/$(database)/documents/users/$(resource.data.memberId)) &&
        get(/databases/$(database)/documents/users/$(resource.data.memberId)).data.enterpriseOwnerId == request.auth.uid;
      
      // No updates needed — delete and recreate instead
      allow update: if false;
    }
  }
}

